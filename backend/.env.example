PORT=5000

# AWS configuration (local backend runtime)
AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=replace_with_iam_user_access_key
AWS_SECRET_ACCESS_KEY=replace_with_iam_user_secret_key
S3_BUCKET_NAME=your-s3-bucket-name
SNS_TOPIC_ARN=arn:aws:sns:your-aws-region:your-account-id:your-sns-topic
# Optional override topic for anomaly alerts
ALERT_SNS_TOPIC_ARN=

# Python/ML runtime
PYTHON_CMD=python
ML_PREDICT_SCRIPT=ml-model/predict.py

# Local model path used by backend inference
MODEL_PATH=ml-model/model/model_updated.pkl

# Optional: pull model from S3 at backend startup
MODEL_S3_BUCKET=your-s3-bucket-name
MODEL_S3_KEY=model/model_updated.pkl
# Set true to enforce S3 model sync and block startup if sync fails
REQUIRE_S3_MODEL=false

# Log file path for autonomous monitoring (relative to project root)
LOG_FILE_PATH=backend/logs/app.log

# CloudWatch Logs configuration
LOG_GROUP=your-cloudwatch-log-group
LOG_STREAM=your-cloudwatch-log-stream

# DynamoDB table names
LOGS_TABLE=LogsTable
ANOMALIES_TABLE=AnomaliesTable
ALERTS_TABLE=AlertsTable
AUTO_HEALING_TABLE=AutoHealingTable

# Dynamic health status tuning
HEALTH_LOG_WINDOW=100
HEALTH_ANOMALY_WINDOW=50
HEALTH_WARN_ERROR_THRESHOLD=8
